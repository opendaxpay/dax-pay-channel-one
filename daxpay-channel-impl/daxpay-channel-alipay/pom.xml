<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>cn.daxpay.open.channel.one</groupId>
        <artifactId>daxpay-channel-impl</artifactId>
        <version>4.0.0-beta3</version>
    </parent>

    <artifactId>daxpay-channel-alipay</artifactId>
    <packaging>jar</packaging>
    <description>支付宝支付通道适配模块</description>

    <dependencies>
        <dependency>
            <groupId>cn.daxpay.open.channel.one</groupId>
            <artifactId>daxpay-platform-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- common-json: ObjectMapper(Jackson 3, service 解析 SDK 返回 JSON) -->
        <dependency>
            <groupId>cn.daxpay.open.channel.one</groupId>
            <artifactId>common-json</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- common-util: PayUtil 等平台金额/工具类 -->
        <dependency>
            <groupId>cn.daxpay.open.channel.one</groupId>
            <artifactId>common-util</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.alipay.sdk</groupId>
            <artifactId>alipay-sdk-java</artifactId>
            <version>${alipay-sdk.version}</version>
            <exclusions>
                <!-- 排除传递的旧版 okhttp 3.x / okio 1.x, 统一本应用 OkHttp 4.x -->
                <exclusion>
                    <groupId>com.squareup.okhttp3</groupId>
                    <artifactId>okhttp</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>com.squareup.okio</groupId>
                    <artifactId>okio</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>cn.hutool</groupId>
            <artifactId>hutool-core</artifactId>
            <version>${hutool.version}</version>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
    </dependencies>
</project>
