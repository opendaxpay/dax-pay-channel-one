<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>cn.daxpay.open</groupId>
        <artifactId>daxpay-channel-one</artifactId>
        <version>4.0.0-beta1</version>
    </parent>

    <artifactId>daxpay-channel-start</artifactId>
    <packaging>jar</packaging>
    <description>通道适配系统启动模块</description>

    <dependencies>
        <!-- service-system: web 组装层(全局异常处理等, 对标主项目 service-system) -->
        <dependency>
            <groupId>cn.daxpay.open</groupId>
            <artifactId>service-system</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!-- RestClient 声明式 HTTP 客户端(Spring Boot 4 拆为独立 starter) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-restclient</artifactId>
        </dependency>
        <!-- 使用 Apache HttpClient 5 作为 http 请求的底层连接池 -->
        <dependency>
            <groupId>org.apache.httpcomponents.client5</groupId>
            <artifactId>httpclient5</artifactId>
        </dependency>
        <!-- 监控端点 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!-- 链路追踪(仅日志关联, 不导出): 排除 otel 导出器, 避免拖入 okhttp 5.x 与抖音 SDK(锁 4.x) 冲突 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-opentelemetry</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>io.opentelemetry</groupId>
                    <artifactId>opentelemetry-exporter-otlp</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- 支付通道对接 -->
        <!-- 支付宝 -->
        <dependency>
            <groupId>cn.daxpay.open</groupId>
            <artifactId>daxpay-channel-alipay</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- 微信 -->
        <dependency>
            <groupId>cn.daxpay.open</groupId>
            <artifactId>daxpay-channel-wechat</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- 抖音 -->
        <dependency>
            <groupId>cn.daxpay.open</groupId>
            <artifactId>daxpay-channel-douyin</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- 银联商务 -->
        <dependency>
            <groupId>cn.daxpay.open</groupId>
            <artifactId>daxpay-channel-ums</artifactId>
            <version>${project.version}</version>
        </dependency>
    </dependencies>

    <build>
        <finalName>daxpay-channel-one</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>cn.daxpay.open.channel.ChannelServiceApp</mainClass>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <!-- 生成 build-info.properties, 供 /actuator/info 端点展示构建信息 -->
                            <goal>build-info</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
